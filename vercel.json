{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/academy/reading-passages/:path*",
      "destination": "/:path*",
      "permanent": false
    },
    {
      "source": "/academy/imported-listening/:path*",
      "destination": "/:path*",
      "permanent": false
    },
    {
      "source": "/academy/:path*",
      "destination": "/:path*",
      "permanent": false
    },
    {
      "source": "/reading-passages/:path*",
      "destination": "/:path*",
      "permanent": false
    },
    {
      "source": "/imported-listening/:path*",
      "destination": "/:path*",
      "permanent": false
    }
  ]
}
